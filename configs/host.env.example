# Copy or source these values for a non-Aisha host before running Compose.
# Keep host-specific secrets and private addresses out of Git.

# Tailnet IP used by services that bind directly to the Tailscale interface.
TAILNET_BIND_IP=100.106.201.14

# Tailnet HTTPS hostname used by Tailscale Serve and Traefik routes.
TAILSCALE_SERVE_HOST=aisha.tail4553c9.ts.net

# LAN IP used by Traefik's HTTPS bind when LAN exposure is enabled.
TRAEFIK_LAN_IP=192.168.1.97

# Hostname advertised to services that display the host identity.
HOMELAB_HOSTNAME=aisha

# Optional source checkout used by Local RAG indexing.
AISHA_KNOWLEDGE_SOURCE=/srv/data/git/homelab-bootstrap-index

# Optional source checkout used by the Aisha/OpenClaw operations Local RAG collection.
AISHA_OPS_SOURCE=/home/nlc/.openclaw/workspace

# Optional Hermes endpoint for the Aisha/OpenClaw operations Local RAG collection.
# Enable with the local-rag "ops" Compose profile.
HERMES_OPS_RAG_URL=http://local-rag-ops-api:8080
