#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
readonly REPO_ROOT

readonly BUNDLE="${REPO_ROOT}/secrets/appliance.enc.yaml"

MODE="check"

usage() {
    cat <<EOF
Restore Aisha runtime secrets from the encrypted SOPS bundle.

Usage:
  scripts/secrets-restore [--check|--apply]

Options:
  --check   Validate and compare secrets without changing runtime files.
            This is the default.
  --apply   Atomically restore secrets to their runtime locations.
  -h, --help
            Show this help.

Environment:
  SOPS_AGE_KEY_FILE must point to the age private-key file.

Runtime destinations:
  /srv/data/services/local-rag/secrets/api-token
  \$HOME/.config/restic/password
  \$HOME/.config/openclaw/secrets.env
EOF
}

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "Required command is unavailable: $1"
}

parse_arguments() {
    while (($# > 0)); do
        case "$1" in
            --check)
                MODE="check"
                ;;
            --apply)
                MODE="apply"
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
        shift
    done
}

main() {
    parse_arguments "$@"

    [[ "$EUID" -ne 0 ]] ||
        die "Run this script as your normal user, not with sudo."

    require_command python3
    require_command sops

    [[ -f "$BUNDLE" ]] ||
        die "Encrypted bundle is missing: ${BUNDLE}"

    [[ -n "${SOPS_AGE_KEY_FILE:-}" ]] ||
        die "SOPS_AGE_KEY_FILE is not set."

    [[ -f "$SOPS_AGE_KEY_FILE" ]] ||
        die "Age identity file does not exist: ${SOPS_AGE_KEY_FILE}"

    DECRYPTED_JSON="$(mktemp)"

    cleanup() {
        if [[ -n "${DECRYPTED_JSON:-}" ]]; then
            rm -f -- "$DECRYPTED_JSON"
        fi
    }

    trap cleanup EXIT

    umask 077

    sops --decrypt \
        --output-type json \
        "$BUNDLE" > "$DECRYPTED_JSON"

    python3 - "$MODE" "$DECRYPTED_JSON" <<'PY'
import json
import os
import stat
import sys
import tempfile
from pathlib import Path


mode = sys.argv[1]
source = Path(sys.argv[2])

with source.open("r", encoding="utf-8") as handle:
    data = json.load(handle)


def required_string(*keys: str) -> str:
    value = data
    for key in keys:
        if not isinstance(value, dict) or key not in value:
            raise SystemExit(
                f"Missing required secret: {'.'.join(keys)}"
            )
        value = value[key]

    if not isinstance(value, str) or not value.strip():
        raise SystemExit(
            f"Secret must be a non-empty string: {'.'.join(keys)}"
        )

    return value.strip()


local_rag_token = required_string("local_rag", "api_token")
restic_password = required_string("restic", "password")
openclaw_environment = required_string("openclaw", "environment")

if len(local_rag_token) < 32:
    raise SystemExit("Local RAG token must contain at least 32 characters.")

if any(character.isspace() for character in local_rag_token):
    raise SystemExit("Local RAG token must not contain whitespace.")

required_openclaw_keys = {
    "OPENCLAW_DISCORD_TOKEN",
    "OPENCLAW_GATEWAY_TOKEN",
}

present_openclaw_keys = {
    line.split("=", 1)[0].strip()
    for line in openclaw_environment.splitlines()
    if "=" in line and not line.lstrip().startswith("#")
}

missing_openclaw_keys = required_openclaw_keys - present_openclaw_keys

if missing_openclaw_keys:
    raise SystemExit(
        "OpenClaw environment is missing: "
        + ", ".join(sorted(missing_openclaw_keys))
    )


targets = [
    (
        Path("/srv/data/services/local-rag/secrets/api-token"),
        local_rag_token + "\n",
        0o604,
    ),
    (
        Path.home() / ".config/restic/password",
        restic_password + "\n",
        0o600,
    ),
    (
        Path.home() / ".config/openclaw/secrets.env",
        openclaw_environment.rstrip() + "\n",
        0o600,
    ),
]


def refuse_unsafe_path(path: Path) -> None:
    if path.is_symlink():
        raise SystemExit(f"Refusing symlinked destination: {path}")

    current = path.parent
    while current != current.parent:
        if current.is_symlink():
            raise SystemExit(f"Refusing symlinked parent directory: {current}")
        current = current.parent


def existing_content(path: Path) -> str | None:
    if not path.exists():
        return None

    if not path.is_file():
        raise SystemExit(f"Destination is not a regular file: {path}")

    return path.read_text(encoding="utf-8")


def install_secret(path: Path, content: str, file_mode: int) -> bool:
    refuse_unsafe_path(path)

    path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)

    current = existing_content(path)

    if current == content:
        os.chmod(path, file_mode)
        return False

    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        dir=path.parent,
        text=True,
    )

    temporary_path = Path(temporary_name)

    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())

        os.chmod(temporary_path, file_mode)
        os.replace(temporary_path, path)
    finally:
        temporary_path.unlink(missing_ok=True)

    return True


changes_required = False

for path, content, file_mode in targets:
    refuse_unsafe_path(path)
    current = existing_content(path)

    content_matches = current == content
    mode_matches = (
        path.exists()
        and stat.S_IMODE(path.stat().st_mode) == file_mode
    )

    if content_matches and mode_matches:
        print(f"[OK] {path}: current")
        continue

    changes_required = True

    if mode == "check":
        state = "missing" if current is None else "differs"
        print(f"[CHANGE] {path}: {state}")
        continue

    changed = install_secret(path, content, file_mode)

    if changed:
        print(f"[RESTORED] {path}")
    else:
        print(f"[PERMISSIONS] {path}: corrected")


if mode == "check":
    if changes_required:
        print("Secret restoration is required.")
        raise SystemExit(2)

    print("All runtime secrets match the encrypted bundle.")
else:
    print("Secret restoration completed successfully.")
PY
}

main "$@"
