{
  "name": "mission-control-slack-alerts",
  "nodes": [
    {
      "parameters": {
        "path": "mission-control/slack",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 320]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "text",
              "value": "=={{ '*Mission Control*\n' + ($json.body.title || 'Untitled event') + (($json.body.kind || $json.body.risk) ? ('\nType: ' + ($json.body.kind || 'event') + ' | Risk: ' + ($json.body.risk || 'low')) : '') + (($json.body.summary || $json.body.detail) ? ('\n' + ($json.body.summary || $json.body.detail)) : '') + ($json.body.requested_by ? ('\nRequested by: ' + $json.body.requested_by) : '') + ($json.body.dashboard_url ? ('\nDashboard: ' + $json.body.dashboard_url) : '') } }"
            }
          ]
        },
        "options": {}
      },
      "id": "format-message",
      "name": "Format Slack Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: $json.text } }}",
        "options": {}
      },
      "id": "post-to-slack",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [820, 320]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Format Slack Message", "type": "main", "index": 0 }]]
    },
    "Format Slack Message": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
