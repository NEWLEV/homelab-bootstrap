#!/usr/bin/env bash
set -Eeuo pipefail

# Compatibility wrapper for the old consolidation command. The native
# gateway and the repository-managed Aisha gateway are intentionally separate.
readonly REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly NATIVE_UNIT="openclaw-gateway.service"
readonly NATIVE_UI_URL="${OPENCLAW_UI_URL:-https://aisha.tail4553c9.ts.net/openclaw/}"
readonly AISHA_HEALTH_URL="${AISHA_HEALTH_URL:-https://aisha.tail4553c9.ts.net/aisha/api/health}"

usage() {
    printf 'Usage: %s --dry-run | --apply | --verify\n' "$0"
}

native_service_is_active() {
    local service_user="${SUDO_USER:-$(id -un)}"
    local service_uid
    service_uid="$(id -u "$service_user")"
    if [[ "$service_user" == "$(id -un)" ]]; then
        systemctl --user is-enabled --quiet "$NATIVE_UNIT" &&
            systemctl --user is-active --quiet "$NATIVE_UNIT"
        return
    fi
    sudo -n -u "$service_user" env XDG_RUNTIME_DIR="/run/user/$service_uid" \
        systemctl --user is-enabled --quiet "$NATIVE_UNIT" &&
        sudo -n -u "$service_user" env XDG_RUNTIME_DIR="/run/user/$service_uid" \
            systemctl --user is-active --quiet "$NATIVE_UNIT"
}

container_is_healthy() {
    [[ "$(docker inspect openclaw --format '{{.State.Status}} {{.State.Health.Status}}' 2>/dev/null)" == \
        'running healthy' ]]
}

native_ui_is_ready() {
    curl --fail --silent --show-error --max-time 10 "$NATIVE_UI_URL" |
        grep -Fq 'data-openclaw-control-ui-base-path="/openclaw"'
}

aisha_chat_is_ready() {
    curl --fail --silent --show-error --max-time 10 "$AISHA_HEALTH_URL" |
        jq -e '.ready == true' >/dev/null
}

serve_is_ready() {
    local status
    status="$(tailscale serve status 2>/dev/null)"
    grep -Eq '^\|-- /[[:space:]]+proxy http://127.0.0.1:18080$' <<<"$status" &&
        grep -Eq '^\|-- /openclaw[[:space:]]+proxy http://127.0.0.1:18789/openclaw$' <<<"$status"
}

gateway_ports_are_loopback_only() {
    local listeners
    listeners="$(ss -ltnH | awk '$4 ~ /:(18789|18790)$/ { print $4 }')"
    [[ -n "$listeners" ]] || return 1
    ! grep -Evq '^(127\.0\.0\.1:(18789|18790)|\[::1\]:(18789|18790))$' <<<"$listeners"
}

verify_state() {
    local failed=0

    native_service_is_active || {
        printf '%s\n' 'FAIL: native OpenClaw user service is not enabled and active.' >&2
        failed=1
    }
    container_is_healthy || {
        printf '%s\n' 'FAIL: repository-managed Aisha container is not healthy.' >&2
        failed=1
    }
    gateway_ports_are_loopback_only || {
        printf '%s\n' 'FAIL: native OpenClaw gateway is not loopback-only.' >&2
        failed=1
    }
    serve_is_ready || {
        printf '%s\n' 'FAIL: Tailscale Serve does not own the expected routes.' >&2
        failed=1
    }
    native_ui_is_ready || {
        printf '%s\n' 'FAIL: native OpenClaw Control UI route is not ready.' >&2
        failed=1
    }
    aisha_chat_is_ready || {
        printf '%s\n' 'FAIL: Aisha chat route is not ready.' >&2
        failed=1
    }

    if ((failed == 0)); then
        printf '%s\n' 'PASS: native OpenClaw and Aisha have separate healthy routes.'
    fi

    return "$failed"
}

if (($# != 1)); then
    usage >&2
    exit 2
fi

case "$1" in
    --dry-run)
        printf '+ verify native unit, loopback gateway, Serve routes, and Aisha health\n'
        printf '+ no runtime changes are made by this compatibility command\n'
        ;;
    --apply)
        if ((EUID != 0)); then
            printf 'Run as root: sudo bash %s --apply\n' "$0" >&2
            exit 1
        fi
        printf '%s\n' 'The old consolidation action is retired; reconciling the canonical ingress instead.'
        exec bash "$REPO_ROOT/scripts/reconfigure-ai-ingress"
        ;;
    --verify)
        verify_state
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
