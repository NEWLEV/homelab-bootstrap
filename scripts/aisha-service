#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO

declare -A STACKS=(
  [homepage]="$REPO/compose/core/homepage.yml"
  [portainer]="$REPO/compose/core/portainer.yml"
  [filebrowser]="$REPO/compose/core/filebrowser.yml"
  [uptime-kuma]="$REPO/compose/monitoring/uptime-kuma.yml"
  [netdata]="$REPO/compose/monitoring/netdata.yml"
  [traefik]="$REPO/compose/networking/traefik.yml"
  [openclaw]="$REPO/compose/ai/openclaw.yml"
  [hermes]="$REPO/compose/ai/hermes.yml"
)

usage() {
cat <<HELP
Usage:
  aisha-service list
  aisha-service ps
  aisha-service up <service|all>
  aisha-service down <service|all>
  aisha-service restart <service|all>
  aisha-service update <service|all>
  sudo aisha-service ingress
  aisha-service logs <service>
HELP
}

compose() {
    docker compose -f "${STACKS[$1]}" "${@:2}"
}

case "${1:-}" in
list)
    printf "%s\n" "${!STACKS[@]}" | sort
    ;;

ps)
    docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    ;;

up|down|restart)
    if [[ "${2:-}" == "all" ]]; then
        for s in "${!STACKS[@]}"; do
            compose "$s" "$1"
        done
    else
        compose "$2" "$1"
    fi
    ;;

update)
    if [[ "${2:-}" == "all" ]]; then
        for s in "${!STACKS[@]}"; do
            compose "$s" pull
            compose "$s" up -d
        done
    else
        compose "$2" pull
        compose "$2" up -d
    fi
    ;;

logs)
    compose "$2" logs -f --tail=100
    ;;

ingress)
    bash "$REPO/scripts/reconfigure-ai-ingress"
    ;;

*)
    usage
    ;;
esac
